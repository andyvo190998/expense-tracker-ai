APP_ENV=development
PORT=3002

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_ALLOW_LOCAL_PLAINTEXT=true
# Production uses SASL/TLS and KAFKA_ALLOW_LOCAL_PLAINTEXT=false.
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
# The password is a Brevo SMTP key.
BREVO_SMTP_PASSWORD=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Expense Tracker

# Optional Observe credentials.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
