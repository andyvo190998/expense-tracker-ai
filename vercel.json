{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "expense-api": {
      "root": "apps/expense-api",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "expense-api", "format": "url", "env": "EXPENSE_API_URL" },
        { "type": "service", "service": "workforce-api", "format": "url", "env": "WORKFORCE_API_URL" }
      ]
    },
    "workforce-api": {
      "root": "apps/workforce-api",
      "framework": "nestjs",
      "buildCommand": "pnpm prisma:generate && pnpm build"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "daemons": {
    "notification-server": {
      "root": ".",
      "entrypoint": "apps/notification-server/Dockerfile",
      "instances": { "fra1": 1 }
    },
    "expense-outbox-relay": {
      "root": ".",
      "entrypoint": "apps/expense-api/Dockerfile",
      "command": ["python", "-m", "app.outbox_relay"],
      "instances": { "fra1": 1 }
    }
  }
}
